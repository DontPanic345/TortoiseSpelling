{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node", "@wdio/globals/types", "@wdio/cucumber-framework", "@wdio/appium-service"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
