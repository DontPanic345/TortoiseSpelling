{
  "name": "tortoisespelling-e2e",
  "private": true,
  "type": "module",
  "description": "BDD end-to-end tests for the Tortoise Spelling Android app: Cucumber features driven by WebdriverIO through Appium's UiAutomator2 driver.",
  "scripts": {
    "e2e": "wdio run ./wdio.conf.ts",
    "e2e:slow": "wdio run ./wdio.conf.ts --cucumberOpts.tags=@slow",
    "e2e:release": "wdio run ./wdio.conf.ts --cucumberOpts.tags=@release-smoke",
    "check-steps": "node --import tsx scripts/checkSteps.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cucumber/cucumber": "~13.3.0",
    "@types/node": "~22.20.5",
    "@wdio/appium-service": "~10.1.0",
    "@wdio/cli": "~10.1.0",
    "@wdio/cucumber-framework": "~10.1.0",
    "@wdio/globals": "~10.1.0",
    "@wdio/local-runner": "~10.1.0",
    "@wdio/spec-reporter": "~10.1.0",
    "@wdio/types": "~10.1.0",
    "appium": "~3.8.0",
    "appium-uiautomator2-driver": "~8.7.0",
    "tsx": "~4.23.15",
    "typescript": "~7.0.2"
  }
}
