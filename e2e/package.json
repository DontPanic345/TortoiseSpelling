{
  "name": "tortoisespelling-e2e",
  "private": true,
  "type": "module",
  "description": "BDD end-to-end tests for the TortoiseSpelling Android app: Cucumber features driven by WebdriverIO through Appium's UiAutomator2 driver.",
  "scripts": {
    "e2e": "wdio run ./wdio.conf.ts",
    "e2e:slow": "wdio run ./wdio.conf.ts --cucumberOpts.tags=@slow",
    "check-steps": "node --import tsx scripts/checkSteps.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cucumber/cucumber": "~13.2.1",
    "@types/node": "~22.20.2",
    "@wdio/appium-service": "~9.31.8",
    "@wdio/cli": "~9.31.8",
    "@wdio/cucumber-framework": "~9.31.7",
    "@wdio/globals": "~9.31.3",
    "@wdio/local-runner": "~9.31.8",
    "@wdio/spec-reporter": "~9.31.2",
    "@wdio/types": "~9.31.2",
    "appium": "~3.7.0",
    "appium-uiautomator2-driver": "~8.6.4",
    "tsx": "~4.23.13",
    "typescript": "~7.0.2"
  }
}
