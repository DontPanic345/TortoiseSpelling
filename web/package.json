{
  "name": "tortoisespelling-web",
  "private": true,
  "type": "module",
  "description": "The Tortoise Spelling web app: a TypeScript port of the Android app's word logic, proved equal to the Kotlin by the golden cases in ../golden.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "idb": "~8.0.4",
    "preact": "~11.0.1"
  },
  "devDependencies": {
    "@testing-library/preact": "~3.2.4",
    "@types/node": "~22.20.5",
    "fake-indexeddb": "~6.2.5",
    "jsdom": "~30.1.3",
    "typescript": "~7.0.2",
    "vite": "~8.3.4",
    "vitest": "~5.0.5"
  }
}
