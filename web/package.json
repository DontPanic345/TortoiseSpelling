{
  "name": "tortoisespelling-web",
  "private": true,
  "type": "module",
  "description": "The Tortoise Spelling web app: a TypeScript port of the Android app's word logic, proved equal to the Kotlin by the golden cases in ../golden.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "preview": "vite preview --port 4173 --strictPort",
    "preview:e2e": "vite preview --outDir dist-e2e --port 4174 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "smoke": "playwright test",
    "check-steps": "node scripts/check-steps.mjs",
    "specs": "bddgen -c playwright.specs.config.ts && playwright test -c playwright.specs.config.ts",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "idb": "~8.0.4",
    "preact": "~11.0.1"
  },
  "devDependencies": {
    "@playwright/test": "~1.64.1",
    "@testing-library/preact": "~3.2.4",
    "@types/node": "~22.20.5",
    "fake-indexeddb": "~6.2.5",
    "jsdom": "~30.1.3",
    "playwright-bdd": "~9.2.1",
    "typescript": "~7.0.2",
    "vite": "~8.3.4",
    "vitest": "~5.0.5"
  }
}
